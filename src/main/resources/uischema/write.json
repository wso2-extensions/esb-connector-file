{
    "connectorName": "file",
    "operationName": "write",
    "title": "create file and writes the content",
    "help": "<h1>Write Files</h1><b>Create File And Writes The Content.</b><br><br><ul><li><a href=\"https://ei.docs.wso2.com/en/latest/micro-integrator/references/connectors/file-connector/file-connector-config/\"> More Help </a></li></ul>",
    "elements": [
        {
            "type": "attributeGroup",
            "value": {
                "groupName": "General",
                "elements": [
                    {
                        "type": "attribute",
                        "value": {
                            "name": "configRef",
                            "displayName": "File Connection",
                            "inputType": "connection",
                            "allowedConnectionTypes": [
                                "LOCAL",
                                "FTP",
                                "FTPS",
                                "SFTP",
                                "SMB2"
                            ],
                            "defaultType": "connection.local",
                            "defaultValue": "",
                            "required": "true",
                            "helpTip": "File connection to be used"
                        }
                    },
                    {
                        "type": "attributeGroup",
                        "value": {
                            "groupName": "Basic",
                            "elements": [
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "filePath",
                                        "displayName": "File Path",
                                        "inputType": "stringOrExpression",
                                        "defaultValue": "",
                                        "required": "true",
                                        "helpTip": "Path of the file to be written."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "contentOrExpression",
                                        "displayName": "Content/Expression",
                                        "inputType": "expressionTextArea",
                                        "defaultValue": "",
                                        "required": "false",
                                        "enableCondition": [
                                            "NOT",
                                            {
                                                "enableStreaming": "true"
                                            }
                                        ],
                                        "helpTip": "Static content or expression to receive content. If not given what is message body will get written."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "mimeType",
                                        "displayName": "MIME Type",
                                        "inputType": "comboOrExpression",
                                        "comboValues": [
                                            "Automatic",
                                            "text/plain",
                                            "application/xml",
                                            "application/binary",
                                            "application/octet-stream",
                                            "application/json",
                                            "text/xml"
                                        ],
                                        "defaultValue": "Automatic",
                                        "enableCondition": [
                                            "NOT",
                                            {
                                                "enableStreaming": "true"
                                            }
                                        ],
                                        "required": "true",
                                        "helpTip": "MIME Type of the message. When formatting message for writing this will be used. application/binary takes a base64 content and writes the decoded bytes, application/octet-stream writes the content as it is given."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "writeMode",
                                        "displayName": "Write Mode",
                                        "inputType": "comboOrExpression",
                                        "comboValues": [
                                            "Overwrite",
                                            "Append",
                                            "Create New"
                                        ],
                                        "defaultValue": "Overwrite",
                                        "required": "true",
                                        "helpTip": "Write mode to use - overwrite, append or create new."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "appendPosition",
                                        "displayName": "Position",
                                        "inputType": "stringOrExpression",
                                        "defaultValue": "",
                                        "required": "false",
                                        "enableCondition": [
                                            {
                                                "writeMode": "Append"
                                            }
                                        ],
                                        "helpTip": "Position to append the content. Only used when WriteMode is APPEND."
                                    }
                                }
                            ]
                        }
                    },
                    {
                        "type": "attributeGroup",
                        "value": {
                            "groupName": "Advanced",
                            "elements": [
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "encoding",
                                        "displayName": "Encoding",
                                        "inputType": "stringOrExpression",
                                        "defaultValue": "UTF-8",
                                        "required": "false",
                                        "helpTip": "Content Encoding. Applied when a value for content/expression is present."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "compress",
                                        "displayName": "Compress",
                                        "inputType": "booleanOrExpression",
                                        "defaultValue": "false",
                                        "required": "false",
                                        "enableCondition": [
                                            "OR",
                                            {
                                                "writeMode": "Create New"
                                            },
                                            {
                                                "writeMode": "Overwrite"
                                            }
                                        ],
                                        "helpTip": "Whether to compress as a zip and write. Available only when WriteMode is Create New or OverWrite."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "appendNewLine",
                                        "displayName": "Append New Line",
                                        "inputType": "booleanOrExpression",
                                        "defaultValue": "false",
                                        "required": "false",
                                        "enableCondition": [
                                            "NOT",
                                            {
                                                "enableStreaming": "true"
                                            }
                                        ],
                                        "helpTip": "Whether to append a new line character the the end of written content."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "enableStreaming",
                                        "displayName": "Enable Streaming",
                                        "inputType": "booleanOrExpression",
                                        "defaultValue": "false",
                                        "required": "true",
                                        "helpTip": "Write to the file in streaming manner. With true a binary body under application/octet-stream is read once and written with no copy in memory, and no body is kept, also when overwriteBody is false. Under another type the formatter of the type writes the body as with false. A body from a streamed read under application/binary is written as it is read, with no copy in memory."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "enableLock",
                                        "displayName": "Enable Locking",
                                        "inputType": "booleanOrExpression",
                                        "defaultValue": "true",
                                        "required": "true",
                                        "helpTip": "Whether to lock the file when writing"
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "atomicWrite",
                                        "displayName": "Atomic Write",
                                        "inputType": "booleanOrExpression",
                                        "defaultValue": "true",
                                        "required": "false",
                                        "helpTip": "Publish the completed file by rename"
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "lastModified",
                                        "displayName": "Source Timestamp",
                                        "inputType": "integerOrExpression",
                                        "defaultValue": "",
                                        "required": "false",
                                        "helpTip": "Source timestamp in epoch milliseconds"
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "updateLastModified",
                                        "displayName": "Update Last Modified Timestamp",
                                        "inputType": "booleanOrExpression",
                                        "defaultValue": "true",
                                        "required": "false",
                                        "helpTip": "Set as false to skip updating the last modified timestamp"
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "maxRetries",
                                        "displayName": "Max Retries",
                                        "inputType": "integerOrExpression",
                                        "defaultValue": "1",
                                        "required": "false",
                                        "helpTip": "Number of retries after a fast transport failure."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "retryDelay",
                                        "displayName": "Retry Interval",
                                        "inputType": "integerOrExpression",
                                        "defaultValue": "0",
                                        "required": "false",
                                        "helpTip": "Deprecated. Retries use the operation frame."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "timeBetweenSizeCheck",
                                        "displayName": "Time Between Size Checks",
                                        "inputType": "stringOrExpression",
                                        "defaultValue": "",
                                        "required": "false",
                                        "helpTip": "Time to wait between file size checks to ensure file stability in milliseconds (e.g., '2000', '5000'). Prevents writing to files still being modified."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "updateFilePermission",
                                        "displayName": "Update File Permission",
                                        "inputType": "stringOrExpression",
                                        "defaultValue": "",
                                        "required": "false",
                                        "helpTip": "File permission to set after writing (e.g., '755', '644'). Supported for local and SFTP files."
                                    }
                                },
                                {
                                    "type": "attribute",
                                    "value": {
                                        "name": "diskShareAccessMask",
                                        "displayName": "Access mask values for disk share",
                                        "inputType": "stringOrExpression",
                                        "defaultValue": "MAXIMUM_ALLOWED",
                                        "required": "false",
                                        "helpTip": "Comma separated access mask values for disk share. This is only applicable for SMB2 connection type."
                                    }
                                }
                            ]
                        }
                    }
                ]
            }
        },
        {
            "type": "attributeGroup",
            "value": {
                "groupName": "Output",
                "elements": [
                    {
                        "type": "attribute",
                        "value": {
                            "name": "responseVariable",
                            "displayName": "Output Variable Name",
                            "inputType": "string",
                            "deriveResponseVariable": "true",
                            "required": "true",
                            "helpTip": "Name of the variable to which the output of the operation should be assigned"
                        }
                    },
                    {
                        "type": "attribute",
                        "value": {
                            "name": "overwriteBody",
                            "displayName": "Overwrite Message Body",
                            "inputType": "checkbox",
                            "defaultValue": "true",
                            "helpTip": "The designer sets true for a new write. A write must name a value. With true the result of the write replaces the message body, so a step after the write no longer has the content, and the response variable holds no result payload. Set false on every write whose body is needed after it, the body is then held in memory. A streamed write keeps no body either way.",
                            "required": "false"
                        }
                    }
                ]
            }
        }
    ]
}
