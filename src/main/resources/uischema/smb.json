{
  "connectorName": "file",
  "connectionName": "SMB2",
  "title": "SMB Connection Config",
  "help": "<h1>File Connector</h1> <b>The file connector supports Local, SMB, FTP, FTPS and SFTP protocols for handling files</b>",
  "elements": [
    {
      "type": "attribute",
      "value": {
        "name": "connectionName",
        "displayName": "Connection Name",
        "inputType": "string",
        "defaultValue": "FILE_CONNECTION_1",
        "required": "true",
        "helpTip": "The name for the file connection",
        "validation": "nameWithoutSpecialCharactors"
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "General",
        "elements": [
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Basic",
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "host",
                    "displayName": "Host",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "true",
                    "helpTip": "Host name of the SMB server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "port",
                    "displayName": "Port",
                    "inputType": "string",
                    "defaultValue": "445",
                    "required": "true",
                    "helpTip": "The port number of the SMB server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "username",
                    "displayName": "Username",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Username used to connect with the SMB server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "password",
                    "displayName": "Password",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Password to connect with the SMB server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "workingDir",
                    "displayName": "Working Directory",
                    "inputType": "stringOrExpression",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Working directory (share name and path). File paths in operations should be given relative to this folder"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "encodePassword",
                    "displayName": "EncodePassword",
                    "inputType": "booleanOrExpression",
                    "defaultValue": "false",
                    "required": "false",
                    "helpTip": "Enable this to encode the password if it has special characters"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "enableEncryption",
                    "displayName": "EnableEncryption",
                    "inputType": "booleanOrExpression",
                    "defaultValue": "false",
                    "required": "false",
                    "helpTip": "Enable this to enable encryption when connecting to a file share that enforces encryption"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "maxActiveConnections",
                    "displayName": "maxActiveConnections",
                    "inputType": "string",
                    "defaultValue": "8",
                    "required": "false",
                    "helpTip": " The maximum number of objects (including both idle and active/borrowed) that can exist within the pool at the same time"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "maxIdleConnections",
                    "displayName": "maxIdleConnections",
                    "inputType": "string",
                    "defaultValue": "8",
                    "required": "false",
                    "helpTip": "The maximum number of objects that can remain idle in the pool"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "maxWaitTime",
                    "displayName": "maxWaitTime",
                    "inputType": "string",
                    "defaultValue": "10000",
                    "required": "false",
                    "helpTip": "The maximum amount of time that the borrowObject() method should block"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "evictionCheckInterval",
                    "displayName": "evictionCheckInterval",
                    "inputType": "string",
                    "defaultValue": "60000",
                    "required": "false",
                    "helpTip": "The time interval between runs of the idle object evictor thread"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "minEvictionTime",
                    "displayName": "minEvictionTime",
                    "inputType": "string",
                    "defaultValue": "300000",
                    "required": "false",
                    "helpTip": "The minimum amount of time an object must sit idle in the pool before it is eligible for eviction by the idle object evictor "
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "exhaustedAction",
                    "displayName": "exhaustedAction",
                    "inputType": "string",
                    "defaultValue": "WHEN_EXHAUSTED_BLOCK",
                    "required": "false",
                    "helpTip": "Determines the action to take when the borrowObject() method is called, but the pool is exhausted"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Advanced",
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "streamIdleTimeout",
              "displayName": "Stream Idle Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "60000",
              "required": "false",
              "helpTip": "Idle time for a stream or its retained lock in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "autoLockRelease",
              "displayName": "Auto Lock Release",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip": "Allow stale locks to be released."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "lockStaleAge",
              "displayName": "Lock Stale Age",
              "inputType": "integerOrExpression",
              "defaultValue": "900000",
              "required": "false",
              "helpTip": "Stale lock age in milliseconds. Use -1 to disable stale age expiry."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "useTempFolder",
              "displayName": "Use Temp Folder",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip": "Write temporary files in a subfolder."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "tempFolderName",
              "displayName": "Temp Folder Name",
              "inputType": "stringOrExpression",
              "defaultValue": ".part",
              "required": "false",
              "helpTip": "Name of the temporary subfolder."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "tempFileSuffix",
              "displayName": "Temp File Suffix",
              "inputType": "stringOrExpression",
              "defaultValue": ".part",
              "required": "false",
              "helpTip": "Suffix of temporary files."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxFailureRetryCount",
              "displayName": "Max Failure Retry Count",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Deprecated. This setting has no effect."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "userDirIsRoot",
              "displayName": "User Dir Is Root",
              "inputType": "booleanOrExpression",
              "defaultValue": "false",
              "required": "false",
              "helpTip": "Treat the user directory as the root directory."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "smb2ReadTimeout",
              "displayName": "Smb2 Read Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "SMB2 read timeout in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "smb2WriteTimeout",
              "displayName": "Smb2 Write Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "SMB2 write timeout in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "smb2TransactTimeout",
              "displayName": "Smb2 Transact Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "SMB2 transaction timeout in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "smb2DfsEnabled",
              "displayName": "Smb2 DFS Enabled",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip": "When true, the SMB2 client resolves DFS paths. Set false for a server that does not use DFS."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "writeStallTimeout",
              "displayName": "Write Stall Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Socket write stall timeout in milliseconds. Set to zero to disable it."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "fileLockScheme",
              "displayName": "File Locking Behaviour",
              "inputType": "comboOrExpression",
              "comboValues": ["Local", "Cluster"],
              "defaultValue": "Local",
              "required": "false",
              "helpTip":"Deprecated. Both Local and Cluster use the share lock."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "fileCacheEnabled",
              "displayName": "File Cache Enabled",
              "inputType": "booleanOrExpression",
              "defaultValue": "false",
              "required": "false",
              "helpTip":"Enable the bounded file object cache."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendOnConnectionFailure",
              "displayName": "Suspend On Connection Failure",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip":"Suspend connection on failure"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "retriesBeforeSuspension",
              "displayName": "Retries Before Suspension",
              "inputType": "stringOrExpression",
              "defaultValue": "0",
              "required": "false",
              "helpTip":"Number of retries before suspending the connection"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendInitialDuration",
              "displayName": "Suspend Initial Duration (ms)",
              "inputType": "stringOrExpression",
              "defaultValue": "1000",
              "required": "false",
              "helpTip":"Initial duration in milliseconds to suspend the connection"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendProgressionFactor",
              "displayName": "Suspend Progression Factor",
              "inputType": "stringOrExpression",
              "defaultValue": "1.0",
              "required": "false",
              "helpTip":"Progression factor for suspension duration"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendMaximumDuration",
              "displayName": "Suspend Maximum Duration (ms)",
              "inputType": "stringOrExpression",
              "defaultValue": "300000",
              "required": "false",
              "helpTip":"Maximum duration in milliseconds to suspend the connection"
            }
          }
        ]
      }
    }
  ]
}
