{
  "connectorName": "file",
  "connectionName": "FTP",
  "title": "FTP Connection Config",
  "help": "<h1>File Connector</h1> <b>The file connector supports Local, FTP, FTPS and SFTP protocols for handling files</b>",
  "elements": [
    {
      "type": "attribute",
      "value": {
        "name": "connectionName",
        "displayName": "Connection Name",
        "inputType": "string",
        "defaultValue": "FILE_CONNECTION_1",
        "required": "true",
        "helpTip": "The name for the file connection",
        "validation": "nameWithoutSpecialCharactors"
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "General",
        "elements": [
          {
            "type": "attributeGroup",
            "value": {
              "groupName": "Basic",
              "elements": [
                {
                  "type": "attribute",
                  "value": {
                    "name": "host",
                    "displayName": "Host",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "true",
                    "helpTip": "Host name of the FTP server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "port",
                    "displayName": "Port",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "true",
                    "helpTip": "The port number of the FTP server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "username",
                    "displayName": "Username",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Username used to connect with the FTP server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "password",
                    "displayName": "Password",
                    "inputType": "string",
                    "defaultValue": "",
                    "required": "false",
                    "helpTip": "Password to connect with the FTP server"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "encodePassword",
                    "displayName": "EncodePassword",
                    "inputType": "booleanOrExpression",
                    "defaultValue": "false",
                    "required": "false",
                    "helpTip": "Enable this to encode the password if it has special characters"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "userDirIsRoot",
                    "displayName": "User Directory Is Root",
                    "inputType": "booleanOrExpression",
                    "defaultValue": "false",
                    "required": "true",
                    "helpTip": "True if user directory is considered as root directory"
                  }
                },
                {
                  "type": "attribute",
                  "value": {
                    "name": "workingDir",
                    "displayName": "Working Directory",
                    "inputType": "string",
                    "defaultValue": "/",
                    "required": "false",
                    "helpTip": "Working directory. File paths in operations should be given w.r.t this folder. Eg: /Users/username/Downloads"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "attributeGroup",
      "value": {
        "groupName": "Advanced",
        "elements": [
          {
            "type": "attribute",
            "value": {
              "name": "isPassive",
              "displayName": "Is Passive",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip":"True if to enter into passive mode"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "ftpConnectionTimeout",
              "displayName": "FTP Connection Timeout",
              "inputType": "stringOrExpression",
              "defaultValue": "",
              "required": "no",
              "helpTip":"Timeout in milisec for initial control connection"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "retryCount",
              "displayName": "retryCount for FTP Connection",
              "inputType": "stringOrExpression",
              "defaultValue": "5",
              "required": "no",
              "helpTip":"Number of times to retry for FTP Connection"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "ftpSocketTimeout",
              "displayName": "FTP Socket Timeout",
              "inputType": "stringOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip":"Socket timeout for FTP client"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxActiveConnections",
              "displayName": "Max Active Connections",
              "inputType": "integerOrExpression",
              "defaultValue": "8",
              "required": "false",
              "helpTip": "Maximum number of handlers in the pool."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxIdleConnections",
              "displayName": "Max Idle Connections",
              "inputType": "integerOrExpression",
              "defaultValue": "8",
              "required": "false",
              "helpTip": "Maximum number of idle handlers."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxWaitTime",
              "displayName": "Max Wait Time",
              "inputType": "integerOrExpression",
              "defaultValue": "10000",
              "required": "false",
              "helpTip": "Maximum pool borrow wait in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "exhaustedAction",
              "displayName": "Exhausted Action",
              "inputType": "stringOrExpression",
              "defaultValue": "WHEN_EXHAUSTED_BLOCK",
              "required": "false",
              "helpTip": "Wait for a handler up to the pool borrow timeout."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "evictionCheckInterval",
              "displayName": "Eviction Check Interval",
              "inputType": "integerOrExpression",
              "defaultValue": "60000",
              "required": "false",
              "helpTip": "Time between idle handler checks in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "minEvictionTime",
              "displayName": "Min Eviction Time",
              "inputType": "integerOrExpression",
              "defaultValue": "300000",
              "required": "false",
              "helpTip": "Minimum idle time before eviction in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "streamIdleTimeout",
              "displayName": "Stream Idle Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "60000",
              "required": "false",
              "helpTip": "Idle time for a stream or its retained lock in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "autoLockRelease",
              "displayName": "Auto Lock Release",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip": "Allow stale locks to be released."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "lockStaleAge",
              "displayName": "Lock Stale Age",
              "inputType": "integerOrExpression",
              "defaultValue": "900000",
              "required": "false",
              "helpTip": "Stale lock age in milliseconds. Use -1 to disable stale age expiry."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "lockReleaseSameNode",
              "displayName": "Lock Release Same Node",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip": "Lock release preference for a migrated interval. An explicit stale age takes precedence."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "useTempFolder",
              "displayName": "Use Temp Folder",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip": "Write temporary files in a subfolder."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "tempFolderName",
              "displayName": "Temp Folder Name",
              "inputType": "stringOrExpression",
              "defaultValue": ".part",
              "required": "false",
              "helpTip": "Name of the temporary subfolder."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "tempFileSuffix",
              "displayName": "Temp File Suffix",
              "inputType": "stringOrExpression",
              "defaultValue": ".part",
              "required": "false",
              "helpTip": "Suffix of temporary files."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "maxFailureRetryCount",
              "displayName": "Max Failure Retry Count",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Deprecated. This setting has no effect."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "ftpDataTimeout",
              "displayName": "Ftp Data Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "FTP data timeout in milliseconds."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "ftpTransferType",
              "displayName": "Ftp Transfer Type",
              "inputType": "comboOrExpression",
              "defaultValue": "BINARY",
              "required": "false",
              "helpTip": "FTP transfer type. Use BINARY or ASCII.",
              "comboValues": [
                "BINARY",
                "ASCII"
              ]
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "writeStallTimeout",
              "displayName": "Write Stall Timeout",
              "inputType": "integerOrExpression",
              "defaultValue": "",
              "required": "false",
              "helpTip": "Socket write stall timeout in milliseconds. Set to zero to disable it."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "fileLockScheme",
              "displayName": "File Locking Behaviour",
              "inputType": "comboOrExpression",
              "comboValues": ["Local", "Cluster"],
              "defaultValue": "Local",
              "required": "false",
              "helpTip":"Deprecated. Both Local and Cluster use the share lock."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "fileCacheEnabled",
              "displayName": "File Cache Enabled",
              "inputType": "booleanOrExpression",
              "defaultValue": "false",
              "required": "false",
              "helpTip":"Enable the bounded file object cache."
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendOnConnectionFailure",
              "displayName": "Suspend On Connection Failure",
              "inputType": "booleanOrExpression",
              "defaultValue": "true",
              "required": "false",
              "helpTip":"Suspend connection on failure"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "retriesBeforeSuspension",
              "displayName": "Retries Before Suspension",
              "inputType": "stringOrExpression",
              "defaultValue": "0",
              "required": "false",
              "helpTip":"Number of retries before suspending the connection"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendInitialDuration",
              "displayName": "Suspend Initial Duration (ms)",
              "inputType": "stringOrExpression",
              "defaultValue": "1000",
              "required": "false",
              "helpTip":"Initial duration in milliseconds to suspend the connection"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendProgressionFactor",
              "displayName": "Suspend Progression Factor",
              "inputType": "stringOrExpression",
              "defaultValue": "1.0",
              "required": "false",
              "helpTip":"Progression factor for suspension duration"
            }
          },
          {
            "type": "attribute",
            "value": {
              "name": "suspendMaximumDuration",
              "displayName": "Suspend Maximum Duration (ms)",
              "inputType": "stringOrExpression",
              "defaultValue": "300000",
              "required": "false",
              "helpTip":"Maximum duration in milliseconds to suspend the connection"
            }
          }
        ]
      }
    }
  ]
}
